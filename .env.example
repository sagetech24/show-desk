# --- Database -------------------------------------------------------------
# Postgres connection string. If unset, the app uses a local file database in
# .data/pglite (dev) or temporary memory (production without a database).
DATABASE_URL=

# --- Login ----------------------------------------------------------------
# Optional. If unset, the first visitor creates the admin password on /setup.
ADMIN_PASSWORD=
# Optional. Random string used to sign login cookies (auto-generated if unset).
SESSION_SECRET=

# --- Instagram Graph API (optional, sample mode when IG_ACCESS_TOKEN is empty)
IG_ACCESS_TOKEN=
# Only for the "Facebook Login" flow (token for a Facebook Page linked to the
# business account). Leave empty for "Instagram Login" tokens.
IG_USER_ID=
# IG_GRAPH_VERSION=v21.0
# IG_SYNC_LIMIT=50

# --- Display --------------------------------------------------------------
# APP_NAME=Shoe Desk
# APP_TIMEZONE=Asia/Manila
# APP_CURRENCY=PHP
# APP_LOCALE=en-PH
